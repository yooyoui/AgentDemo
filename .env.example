# Backend
DATABASE_URL=postgresql+psycopg://visit:visit@localhost:5432/visit_assistant
REDIS_URL=redis://localhost:6379/0
STORAGE_DIR=./backend/uploads
EXPORT_DIR=./backend/exports
MAX_UPLOAD_MB=15
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
APP_ENVIRONMENT=development
# Production must explicitly opt in before customer data may be sent to an external model.
EXTERNAL_DATA_TRANSMISSION_ENABLED=false

# DeepSeek OpenAI-compatible model (optional; leave the key blank for deterministic demo mode)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
# Flash is used for generation; Pro is the fallback for public web search.
LLM_SEARCH_MODEL=deepseek-v4-pro
LLM_TIMEOUT_SECONDS=90
LLM_MAX_TOKENS=4096
LLM_MAX_RETRIES=2
EMBEDDING_MODEL=text-embedding-3-small

# Public search (optional). When configured, Tavily is preferred and DeepSeek Pro
# is used only if Tavily fails or returns no valid results.
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_SEARCH_DEPTH=fast
TAVILY_TIMEOUT_SECONDS=20
TAVILY_MAX_RETRIES=1
TAVILY_FALLBACK_TO_DEEPSEEK=true

# Frontend
# Leave blank for the built-in same-origin proxy; set only when frontend and API are deployed separately.
NEXT_PUBLIC_API_URL=
