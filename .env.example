# Backend
DATABASE_URL=postgresql+psycopg://visit:visit@localhost:5432/visit_assistant
REDIS_URL=redis://localhost:6379/0
STORAGE_DIR=./backend/uploads
EXPORT_DIR=./backend/exports
MAX_UPLOAD_MB=15
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# DeepSeek OpenAI-compatible model (optional; leave the key blank for deterministic demo mode)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
# Flash is used for generation; Pro is required for actual server-side web_search calls.
LLM_SEARCH_MODEL=deepseek-v4-pro
LLM_TIMEOUT_SECONDS=90
LLM_MAX_TOKENS=4096
LLM_MAX_RETRIES=2
EMBEDDING_MODEL=text-embedding-3-small

# Frontend
# Leave blank for the built-in same-origin proxy; set only when frontend and API are deployed separately.
NEXT_PUBLIC_API_URL=
